# 本地服务只绑定回环地址；局域网访问需要在后续安全方案完成后显式开启。
AI_PLATFORM_HOST=127.0.0.1
AI_PLATFORM_WEB_PORT=3000
AI_PLATFORM_API_PORT=8000
AI_PLATFORM_ROOT=./.ai-platform

# 本地开发默认值，不得在生产环境或真实企业试点中复用。
POSTGRES_DB=ai_platform
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=local-development-only
VALKEY_PORT=6379
MINIO_ROOT_USER=ai-platform-local
MINIO_ROOT_PASSWORD=local-development-only

# 阶段 0 默认使用 Mock Provider，真实供应商凭证只能通过平台服务端配置。
MODEL_PROVIDER=mock

# 本地服务只绑定回环地址；局域网访问需要在后续安全方案完成后显式开启。
AI_PLATFORM_HOST=127.0.0.1
AI_PLATFORM_WEB_PORT=3000
AI_PLATFORM_API_PORT=8000
AI_PLATFORM_ROOT=./.ai-platform
AI_PLATFORM_BACKUP_ROOT=./AIPlatformBackups
# 小规模功能开发可按机器实际情况降低；默认 50 GB 保留正式本地基线。
AI_PLATFORM_MIN_FREE_DISK_GB=50
MODEL_PROVIDER_ALLOWED_HOSTS=[]
MODEL_PROVIDER_PROBE_TIMEOUT_SECONDS=10
# 跨实例 SSE 使用无正文 Pub/Sub 唤醒；通知不可用时按轮询周期回查 PostgreSQL。
STREAM_POLL_INTERVAL_MS=250
STREAM_NOTIFICATION_CONNECT_TIMEOUT_SECONDS=0.5
# 可选 OTLP HTTP Trace Collector；留空时不发起外部导出。
OBSERVABILITY_OTLP_ENDPOINT=
OBSERVABILITY_OTLP_TIMEOUT_SECONDS=2
# 仅限 local/test；关闭后必须先由平台管理员发布真实 AI 运行配置。
AI_PLATFORM_LOCAL_MOCK_BOOTSTRAP_ENABLED=true
MASTER_KEY_VERSION=1

# 本地开发默认值，不得在生产环境或真实企业试点中复用。
POSTGRES_DB=ai_platform
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=local-development-only
VALKEY_PORT=6379
MINIO_ROOT_USER=ai-platform-local
MINIO_ROOT_PASSWORD=local-development-only
MINIO_BUCKET=ai-platform-documents
# 首期单文件上限 20 MiB；服务端按实际读取字节执行，不信任客户端声明。
UPLOAD_MAX_FILE_SIZE_BYTES=20971520
INGESTION_MAX_ATTEMPTS=3
INGESTION_BATCH_SIZE=4
INGESTION_LEASE_SECONDS=120
INGESTION_RETRY_BASE_SECONDS=5
INGESTION_DISPATCH_INTERVAL_SECONDS=2
INGESTION_MAX_FILE_SIZE_BYTES=20971520
INGESTION_MAX_PAGE_COUNT=500
INDEXING_BATCH_SIZE=4
INDEXING_LEASE_SECONDS=120
INDEXING_MAX_ATTEMPTS=3
INDEXING_RETRY_BASE_SECONDS=5
INDEXING_DISPATCH_INTERVAL_SECONDS=2
INDEXING_MAX_CHUNK_CHARS=1500
INDEXING_CHUNK_OVERLAP_CHARS=150
INDEXING_CHUNKER_VERSION=structural-char-v1

# 各 Lane 独立调整并发，应用层强制限制在 1～8，防止本地机器资源耗尽。
CONTROL_WORKER_CONCURRENCY=2
PARSING_WORKER_CONCURRENCY=2
OCR_WORKER_CONCURRENCY=1
EMBEDDING_WORKER_CONCURRENCY=1
INDEXING_WORKER_CONCURRENCY=2

# 阶段 0 默认使用 Mock Provider，真实供应商凭证只能通过平台服务端配置。
MODEL_PROVIDER=mock

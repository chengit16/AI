{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-platform.local/contracts/observability/field-registry.v1.schema.json",
  "title": "可观测字段注册表 V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "description",
    "channels",
    "forbidden_field_fragments",
    "forbidden_value_markers",
    "maximum_string_length"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "registry_version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "minLength": 1 },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log", "span", "metric", "alert"],
      "properties": {
        "log": { "$ref": "#/$defs/channel" },
        "span": { "$ref": "#/$defs/channel" },
        "metric": { "$ref": "#/$defs/channel" },
        "alert": { "$ref": "#/$defs/channel" }
      }
    },
    "forbidden_field_fragments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_value_markers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "maximum_string_length": { "type": "integer", "minimum": 32, "maximum": 1024 }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_fields"],
      "properties": {
        "allowed_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    }
  }
}

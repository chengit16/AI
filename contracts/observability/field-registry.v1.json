{
  "schema_version": 1,
  "registry_version": 2,
  "description": "P2-06/P4-10 可观测字段白名单。所有日志、Span、指标标签和告警字段在导出前均须通过本注册表。",
  "channels": {
    "log": {
      "allowed_fields": [
        "access_mode",
        "attempt",
        "cache_status",
        "checked_at",
        "check_code",
        "component",
        "cost_microunits",
        "count",
        "degraded_reason",
        "dependency",
        "duration_ms",
        "environment",
        "error_code",
        "event_name",
        "http_status_code",
        "level",
        "method",
        "notification_mode",
        "operation",
        "outcome",
        "queue",
        "reason_code",
        "request_id",
        "result_size_bytes",
        "risk_level",
        "result_count",
        "route",
        "service",
        "span_id",
        "surface",
        "task_id",
        "task_name",
        "timestamp",
        "trace_id"
      ]
    },
    "span": {
      "allowed_fields": [
        "access_mode",
        "attempt",
        "check_code",
        "component",
        "degraded_reason",
        "dependency",
        "error_code",
        "http_status_code",
        "method",
        "notification_mode",
        "operation",
        "outcome",
        "queue",
        "reason_code",
        "request_id",
        "result_count",
        "route",
        "risk_level",
        "surface",
        "task_id",
        "task_name"
      ]
    },
    "metric": {
      "allowed_fields": [
        "access_mode",
        "cache_status",
        "check_code",
        "component",
        "degraded_reason",
        "dependency",
        "environment",
        "http_status_code",
        "method",
        "notification_mode",
        "operation",
        "outcome",
        "queue",
        "reason_code",
        "route",
        "risk_level",
        "service",
        "surface",
        "task_name"
      ]
    },
    "alert": {
      "allowed_fields": [
        "alert_name",
        "component",
        "environment",
        "observed_value",
        "reason_code",
        "service",
        "severity",
        "status",
        "threshold"
      ]
    }
  },
  "forbidden_field_fragments": [
    "authorization",
    "body",
    "content",
    "cookie",
    "credential",
    "document_id",
    "email",
    "field_value",
    "message",
    "password",
    "payload",
    "prompt",
    "query",
    "secret",
    "session",
    "text",
    "token",
    "user_id",
    "workspace_id"
  ],
  "forbidden_value_markers": [
    "SYNTHETIC_SENSITIVE_MARKER",
    "BEGIN PRIVATE KEY"
  ],
  "maximum_string_length": 160
}

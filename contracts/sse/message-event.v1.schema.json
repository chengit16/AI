{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-platform.local/contracts/sse/message-event.v1.schema.json",
  "title": "SSE MessageEvent V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["event_id", "event_type", "schema_version", "workspace_id", "conversation_id", "message_id", "run_id", "sequence_no", "occurred_at", "expires_at", "trace_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": {
      "enum": ["message.delta", "message.citation", "tool.status", "approval.required", "message.completed", "message.failed", "stream.heartbeat", "message.snapshot"]
    },
    "schema_version": { "const": 1 },
    "workspace_id": { "type": "string", "format": "uuid" },
    "conversation_id": { "type": "string", "format": "uuid" },
    "message_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "sequence_no": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string", "minLength": 16, "maxLength": 64 },
    "payload": { "type": "object" }
  }
}

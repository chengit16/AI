{
  "schema_version": 1,
  "contract_id": "p5-09-v1",
  "jurisdiction_statuses": ["not_configured", "configured"],
  "external_review_statuses": ["not_configured", "approved", "rejected"],
  "retention_classes": [
    "stream_events",
    "published_outbox",
    "attempts_and_dead_letters",
    "minimum_records"
  ],
  "legal_hold_scopes": ["workspace"],
  "lifecycle_operations": ["export", "purge", "retention"],
  "operation_decisions": ["allowed", "blocked", "not_configured"],

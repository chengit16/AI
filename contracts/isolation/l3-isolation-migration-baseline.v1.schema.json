{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-platform.local/contracts/isolation/l3-isolation-migration-baseline.v1.schema.json",
  "title": "P5-08 L3 隔离迁移基线契约",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "resource_profile",
    "checkpoint_order",
    "checkpoint_statuses",
    "route_activation",
    "write_authority",
    "recovery",
    "external_status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "p5-08-v1"},
    "resource_profile": {
      "const": {
        "database": "workspace_dedicated",
        "object_bucket": "workspace_dedicated",
        "encryption_key": "workspace_dedicated",
        "credentials_persisted": false,
        "key_material_persisted": false
      }
    },
    "checkpoint_order": {
      "const": [
        "source_snapshot",
        "database_copy",
        "object_copy",
        "derived_index_rebuild",
        "backup_restore",
        "deletion_propagation"
      ]
    },
    "checkpoint_statuses": {"const": ["passed", "failed"]},
    "route_activation": {
      "const": {
        "required_plan_status": "switch_ready",
        "required_checkpoint_status": "passed",
        "source_target_digest_match": true,
        "atomic_with_plan_completion": true,
        "caller_route_override": false
      }
    },
    "write_authority": {
      "const": {
        "before_switch": "source",
        "after_switch": "target",
        "long_term_dual_write": false,
        "rollback_authority": "source"
      }
    },
    "recovery": {
      "const": {
        "failed_attempts_append_only": true,
        "completion_requires_source_authoritative": true,
        "completion_requires_target_writes_disabled": true
      }
    },
    "external_status": {
      "const": {
        "synthetic_local_postgresql": "required",
        "synthetic_local_minio": "required",
        "synthetic_local_key": "required",
        "real_customer_environment": "not_configured",
        "production_kms_vault": "not_configured"
      }
    }
  },
  "additionalProperties": false
}

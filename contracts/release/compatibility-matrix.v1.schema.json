{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-platform.local/contracts/release/compatibility-matrix.v1.schema.json",
  "title": "AI 智能平台发布兼容矩阵 V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_version",
    "manifest_schema_version",
    "component_rules",
    "database_revisions",
    "runtime_rules",
    "required_images"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "matrix_version": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "manifest_schema_version": { "const": 1 },
    "component_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "minimum_version", "maximum_exclusive_version"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
          "minimum_version": { "$ref": "#/$defs/version" },
          "maximum_exclusive_version": { "$ref": "#/$defs/version" }
        }
      }
    },
    "database_revisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$" }
    },
    "runtime_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version_prefix"],
        "properties": {
          "name": { "enum": ["node", "python"] },
          "version_prefix": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.$" }
        }
      }
    },
    "required_images": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-platform.local/contracts/release/release-manifest.v1.schema.json",
  "title": "AI 智能平台发布清单 V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_version",
    "compatibility_matrix_version",
    "components",
    "database",
    "runtimes",
    "images",
    "manifest_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release_version": { "$ref": "#/$defs/version" },
    "compatibility_matrix_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_revision"],
      "properties": {
        "schema_revision": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$" }
      }
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "python"],
      "properties": {
        "node": { "$ref": "#/$defs/version" },
        "python": { "$ref": "#/$defs/version" }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/image" }
    },
    "manifest_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_digest"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
        "version": { "$ref": "#/$defs/version" },
        "source_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reference", "digest", "platforms"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
        "reference": { "type": "string", "minLength": 3, "maxLength": 255 },
        "digest": { "$ref": "#/$defs/digest" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["linux/amd64", "linux/arm64"] }
        }
      }
    }
  }
}

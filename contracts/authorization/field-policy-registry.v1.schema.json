{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-platform.local/contracts/authorization/field-policy-registry.v1.schema.json",
  "title": "字段策略注册表 V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "rules"],
  "properties": {
    "schema_version": { "const": 1 },
    "registry_version": { "type": "integer", "minimum": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_type", "field_name", "security_level"],
        "properties": {
          "resource_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "field_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,159}$" },
          "security_level": {
            "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
          },
          "inherit_resource_level": { "type": "boolean", "default": false }
        }
      }
    }
  }
}

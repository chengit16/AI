{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-platform.local/contracts/tool-execution/stage-4-acceptance.v1.schema.json",
  "title": "阶段 4 联合验收清单 V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_id",
    "status",
    "baseline_ref",
    "source_scenarios_ref",
    "tool_drill_manifest_ref",
    "synthetic",
    "description",
    "execution_policy",
    "required_invariants",
    "required_gates",
    "required_capabilities",
    "scenarios"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "acceptance_id": { "const": "p4-13-v1" },
    "status": { "const": "frozen" },
    "baseline_ref": { "const": "contracts/tool-execution/tool-execution-baseline.v1.json" },
    "source_scenarios_ref": { "const": "tests/fixtures/tool-execution/p4-01-v1.json" },
    "tool_drill_manifest_ref": { "const": "tests/fixtures/tool-execution/p4-12-v1.json" },
    "synthetic": { "const": true },
    "description": { "$ref": "#/$defs/text" },
    "execution_policy": { "$ref": "#/$defs/execution_policy" },
    "required_invariants": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "required_gates": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/gate" }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "scenarios": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 500 },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,95}$" },
    "gate": {
      "enum": [
        "unauthorized_tool_denial",
        "unconfirmed_side_effect_denial",
        "zero_duplicate_side_effect",
        "step_attempt_traceability",
        "zero_credential_exposure",
        "cancellation_late_result_precedence"
      ]
    },
    "capability": {
      "enum": [
        "catalog_allowlist",
        "immutable_tool_version",
        "task_traceability",
        "internal_read_adapters",
        "deterministic_planning",
        "current_policy_authorization",
        "personal_confirmation",
        "enterprise_approval",
        "credential_boundary",
        "side_effect_idempotency",
        "response_loss_recovery",
        "cancellation_precedence",
        "result_usage_sse_audit",
        "console_http_authorization",
        "fault_drill_contract"
      ]
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight_command",
        "recovery_command",
        "stop_scenarios_on_preflight_failure",
        "always_run_recovery_check",
        "failure_mode",
        "evidence_path"
      ],
      "properties": {
        "preflight_command": { "const": "./platform doctor" },
        "recovery_command": { "const": "./platform doctor" },
        "stop_scenarios_on_preflight_failure": { "const": true },
        "always_run_recovery_check": { "const": true },
        "failure_mode": { "const": "fail_closed" },
        "evidence_path": { "const": ".ai-platform/evidence/p4-13-latest.json" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "title",
        "capability",
        "source_case_refs",
        "pytest_node",
        "expected_case_count",
        "verified_invariants",
        "verified_gates",
        "success_criteria"
      ],
      "properties": {
        "scenario_id": { "type": "string", "pattern": "^p413-[a-z0-9-]+-[0-9]{3}$" },
        "title": { "$ref": "#/$defs/text" },
        "capability": { "$ref": "#/$defs/capability" },
        "source_case_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^p401-[a-z0-9-]+-[0-9]{3}$" }
        },
        "pytest_node": {
          "type": "string",
          "pattern": "^tests/(?:(?:integration|unit)/)?test_[a-z0-9_]+\\.py::test_[a-z0-9_]+$"
        },
        "expected_case_count": { "const": 1 },
        "verified_invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "verified_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/gate" }
        },
        "success_criteria": { "$ref": "#/$defs/text" }
      }
    }
  }
}

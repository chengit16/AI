{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-platform.local/contracts/reliability/failure-scenarios.v1.schema.json",
  "title": "阶段 2 可靠性故障场景数据集 V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "baseline_ref",
    "synthetic",
    "description",
    "categories",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "dataset_version": { "const": "p2-01-v1" },
    "baseline_ref": {
      "const": "contracts/reliability/reliability-baseline.v1.json"
    },
    "synthetic": { "const": true },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "categories": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/category" }
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "category": {
      "enum": [
        "timeout",
        "duplicate",
        "out_of_order",
        "partial_failure",
        "dependency_unavailable",
        "recovery_integrity",
        "authorization_propagation",
        "observability_leak"
      ]
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 500 },
    "text_list": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/text" }
    },
    "fault_injection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["injection_point", "trigger", "occurrences"],
      "properties": {
        "injection_point": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
        },
        "trigger": { "$ref": "#/$defs/text" },
        "occurrences": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_state",
        "verified_invariants",
        "error_code",
        "retryable",
        "maximum_recovery_seconds",
        "duplicate_side_effects",
        "cross_workspace_exposure",
        "authorization_behavior",
        "evidence_sources"
      ],
      "properties": {
        "terminal_state": {
          "enum": ["recovered", "rejected", "failed", "unchanged"]
        },
        "verified_invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,95}$" }
        },
        "error_code": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
          ]
        },
        "retryable": { "type": "boolean" },
        "maximum_recovery_seconds": {
          "oneOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }]
        },
        "duplicate_side_effects": { "const": 0 },
        "cross_workspace_exposure": { "const": false },
        "authorization_behavior": { "enum": ["fail_closed", "not_applicable"] },
        "evidence_sources": { "$ref": "#/$defs/text_list" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "category",
        "component",
        "synthetic",
        "preconditions",
        "fault_injection",
        "steps",
        "expected",
        "cleanup"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^p201-[a-z0-9-]+-[0-9]{3}$"
        },
        "category": { "$ref": "#/$defs/category" },
        "component": {
          "enum": [
            "ingestion_worker",
            "index_worker",
            "object_storage",
            "api_instance",
            "sse_notification",
            "authorization_cache",
            "outbox_dispatcher",
            "lifecycle_worker",
            "recovery_service",
            "observability_pipeline"
          ]
        },
        "synthetic": { "const": true },
        "preconditions": { "$ref": "#/$defs/text_list" },
        "fault_injection": { "$ref": "#/$defs/fault_injection" },
        "steps": { "$ref": "#/$defs/text_list" },
        "expected": { "$ref": "#/$defs/expected" },
        "cleanup": { "$ref": "#/$defs/text_list" }
      }
    }
  }
}

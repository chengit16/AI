{
  "schema_version": 1,
  "contract_id": "p5-10-v1",
  "delivery_mode": "independent_instance",
  "required_services": ["web", "api", "worker", "postgres", "valkey", "minio", "tika"],
  "lifecycle": ["install", "upgrade", "rollback", "restore"],
  "upgrade_policy": {
    "migration_tool": "alembic",
    "backup_before_upgrade": true,
    "rollback_mode": "restore_pre_upgrade_backup",
    "down_migration_for_rollback": false,
    "exact_release_manifest_required": true,
    "newer_backup_into_older_release": false
  },
  "offline_dependencies": [
    {"name": "docker_engine", "mode": "local_required", "network_required": false, "status": "required"},
    {"name": "postgresql", "mode": "local_service", "network_required": false, "status": "required"},
    {"name": "valkey", "mode": "local_service", "network_required": false, "status": "required"},
    {"name": "minio", "mode": "local_service", "network_required": false, "status": "required"},
    {"name": "tika", "mode": "bundled_image", "network_required": false, "status": "required"},
    {"name": "model_provider", "mode": "external_optional", "network_required": true, "status": "not_configured"},
    {"name": "kms_vault", "mode": "production_only", "network_required": true, "status": "not_configured"},
    {"name": "certificates", "mode": "production_only", "network_required": true, "status": "not_configured"}
  ],
  "external_status": {
    "customer_environment": "not_configured",
    "production_kms_vault": "not_configured",
    "production_certificates": "not_configured",
    "production_object_storage": "not_configured",
    "real_model_provider": "not_configured",
    "capacity_certification": "not_run",
    "image_scan": "not_configured"
  },
  "secret_policy": {
    "local_master_key": "generated_outside_git",
    "backup_encryption_key": "operator_managed_separately",
    "production_key_backend": "kms_or_vault",
    "key_material_in_release_manifest": false,
    "application_recovery_keys_encrypted_in_bundle": true,
    "backup_encryption_key_in_bundle": false
  }
}

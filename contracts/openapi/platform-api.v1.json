{
  "openapi": "3.1.0",
  "info": {
    "title": "AI 智能平台 API",
    "version": "0.0.0",
    "summary": "个人空间与企业空间共用的平台服务接口"
  },
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "getLiveness",
        "summary": "Get Liveness",
        "tags": ["系统健康"],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          },
          "500": {
            "description": "平台内部错误",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Get Readiness",
        "tags": ["系统健康"],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          },
          "503": {
            "description": "依赖尚未就绪",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          },
          "500": {
            "description": "平台内部错误",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable", "request_id", "trace_id"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$", "title": "Code" },
          "message": { "type": "string", "title": "Message" },
          "retryable": { "type": "boolean", "title": "Retryable" },
          "request_id": { "type": "string", "format": "uuid", "title": "Request Id" },
          "trace_id": { "type": "string", "minLength": 16, "maxLength": 64, "title": "Trace Id" }
        },
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "status", "version", "environment", "checks"],
        "properties": {
          "service": { "type": "string", "title": "Service" },
          "status": { "type": "string", "enum": ["ok", "degraded"], "title": "Status" },
          "version": { "type": "string", "title": "Version" },
          "environment": { "type": "string", "title": "Environment" },
          "checks": {
            "type": "object",
            "additionalProperties": { "type": "string", "enum": ["ok", "degraded"] },
            "title": "Checks"
          }
        },
        "title": "HealthResponse"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-platform.local/contracts/agent-control/stage-3-acceptance-evidence.v1.schema.json",
  "title": "阶段 3 联合验收证据 V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_version",
    "acceptance_id",
    "run_id",
    "synthetic",
    "manifest_ref",
    "manifest_sha256",
    "repository_revision",
    "repository_dirty",
    "started_at",
    "finished_at",
    "duration_seconds",
    "overall_status",
    "checks",
    "scenarios",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_version": { "const": "p3-13-evidence-v1" },
    "acceptance_id": { "const": "p3-13-v1" },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "synthetic": { "const": true },
    "manifest_ref": {
      "const": "tests/fixtures/agent-control/p3-13-v1.json"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_revision": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        { "const": "unknown" }
      ]
    },
    "repository_dirty": { "type": "boolean" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "duration_seconds": { "type": "number", "minimum": 0 },
    "overall_status": { "enum": ["passed", "failed"] },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight", "scenario_execution", "recovery"],
      "properties": {
        "preflight": { "$ref": "#/$defs/check_result" },
        "scenario_execution": { "$ref": "#/$defs/check_result" },
        "recovery": { "$ref": "#/$defs/check_result" }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 15,
      "items": { "$ref": "#/$defs/scenario_result" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "error", "skipped", "not_run"],
      "properties": {
        "total": { "type": "integer", "minimum": 15 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "not_run": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "reason_code": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" }
      ]
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exit_code", "duration_seconds", "reason_code"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "reason_code": { "$ref": "#/$defs/reason_code" }
      }
    },
    "scenario_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "pytest_node",
        "status",
        "duration_seconds",
        "reason_code"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^p313-[a-z0-9-]+-[0-9]{3}$"
        },
        "pytest_node": {
          "type": "string",
          "pattern": "^tests/(?:integration|unit)/test_[a-z0-9_]+\\.py::test_[a-z0-9_]+$"
        },
        "status": { "enum": ["passed", "failed", "error", "skipped", "not_run"] },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "reason_code": { "$ref": "#/$defs/reason_code" }
      }
    }
  }
}

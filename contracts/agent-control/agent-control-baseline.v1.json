    { "menu_key": "workspace.agents.update", "menu_type": "button", "permission_code": "agent.definition.update", "workspace_types": ["personal", "enterprise"] },
    { "menu_key": "workspace.agents.archive", "menu_type": "button", "permission_code": "agent.definition.archive", "workspace_types": ["personal", "enterprise"] },
    { "menu_key": "workspace.agents.test", "menu_type": "button", "permission_code": "agent.test.execute", "workspace_types": ["personal", "enterprise"] },

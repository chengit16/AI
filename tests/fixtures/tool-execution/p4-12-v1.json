      "pytest_node": "tests/integration/test_p409_tool_recovery_postgres.py::test_cross_workspace_recovery_and_direct_database_bypass_fail_closed",
      "expected_case_count": 1,
      "verified_invariants": [
        "p4_current_policy_recheck",
        "p4_read_write_permission_separation"

      "verified_invariants": [
        "p4_confirmation_digest_binding",
        "p4_idempotency_before_side_effect"
      ],
      "success_criteria": "拒绝、撤回或过期确认只形成不可执行终态，不创建 Attempt、幂等预留或合成副作用。"
    },
    {
      "scenario_id": "p412-cancellation-race-006",
      "title": "取消观察与迟到成功竞态始终由取消终态优先",
      "capability": "cancellation_race",
      "sample_classes": ["cancellation"],
      "source_case_refs": [
        "p401-cancel-running-attempt-018",
        "p401-late-success-ignored-019"
      ],
      "pytest_node": "tests/integration/test_p409_tool_recovery_postgres.py::test_lease_renewal_cancellation_observation_and_late_success_precedence",
      "expected_case_count": 1,
      "verified_invariants": [
        "p4_bounded_retry_and_terminal_precedence",
        "p4_transactional_fact_consistency"
      ],
      "success_criteria": "Worker 观察取消后不再续租或写入成功，迟到结果只能形成隔离事实且不能覆盖取消终态。"
    },
    {
      "scenario_id": "p412-worker-restart-007",
      "title": "Worker 重启从过期租约创建唯一新 Attempt 并隔离旧结果",
      "capability": "worker_restart",
      "sample_classes": ["timeout", "recovery"],
      "source_case_refs": [
        "p401-unsafe-write-retry-denied-023",

      ],
      "pytest_node": "tests/integration/test_p403_tool_task_state_postgres.py::test_cancellation_late_success_and_worker_restart_timeout_never_overwrite_terminal",
      "expected_case_count": 1,
      "verified_invariants": [
        "p4_idempotency_before_side_effect",
        "p4_bounded_retry_and_terminal_precedence",
        "p4_transactional_fact_consistency"
      ],
      "success_criteria": "Worker 重启扫描使过期租约失效并创建唯一新 Attempt，旧 Worker 的迟到成功不能覆盖新执行或已提交终态。"
    },
    {
      "scenario_id": "p412-workspace-isolation-008",
      "title": "跨空间恢复和数据库直接绕过均失败关闭",

  "scenarios": [
    {
      "scenario_id": "p412-duplicate-delivery-001",
      "title": "并发重复投递只产生一个 Adapter 所有者和零重复副作用",
      "capability": "duplicate_delivery",
      "sample_classes": ["success"],
      "source_case_refs": ["p401-idempotent-replay-014"],
      "pytest_node": "tests/integration/test_p408_side_effect_idempotency_postgres.py::test_concurrent_duplicate_delivery_has_one_adapter_call_owner",
      "expected_case_count": 1,
      "verified_invariants": [
        "p4_idempotency_before_side_effect",
        "p4_transactional_fact_consistency"
      ],
      "success_criteria": "两个并发投递只能有一个预留创建者调用 Adapter，幂等记录唯一且重复副作用计数为零。"
    },
    {
      "scenario_id": "p412-adapter-timeout-002",
      "title": "Adapter 超时使当前租约终止并只允许安全只读调用恢复",
      "capability": "adapter_timeout",
      "sample_classes": ["failure", "timeout", "recovery"],
      "source_case_refs": ["p401-unsafe-write-retry-denied-023"],
      "pytest_node": "tests/integration/test_p409_tool_recovery_postgres.py::test_expired_lease_keeps_timeout_usage_before_retry",
      "expected_case_count": 1,
      "verified_invariants": [
        "p4_idempotency_before_side_effect",
        "p4_bounded_retry_and_terminal_precedence"
      ],
      "success_criteria": "Adapter 超时后当前 Attempt 形成不可变超时与用量事实，只有安全只读工具能以新租约恢复且旧 Worker 不能写回。"
    },
    {
      "scenario_id": "p412-response-loss-003",
      "title": "副作用提交后响应丢失只能只读对账且不重复调用",
      "capability": "response_loss",
      "sample_classes": ["failure", "recovery"],
      "source_case_refs": ["p401-outcome-unknown-manual-016"],
      "pytest_node": "tests/integration/test_p408_side_effect_idempotency_postgres.py::test_committed_side_effect_with_lost_response_can_only_be_reconciled",
      "expected_case_count": 1,
      "verified_invariants": [
        "p4_idempotency_before_side_effect",
        "p4_bounded_retry_and_terminal_precedence"
      ],
      "success_criteria": "响应丢失先进入结果未知和人工恢复，只读对账命中既有提交事实，Adapter 与副作用均不发生第二次调用。"
    },
    {
      "scenario_id": "p412-credential-revocation-004",
      "title": "凭证轮换和撤销使已绑定旧引用立即失败关闭",
      "capability": "credential_revocation",
      "sample_classes": ["failure", "denial"],
      "source_case_refs": ["p401-credential-result-leak-020"],
      "pytest_node": "tests/integration/test_p407_tool_credentials_postgres.py::test_rotation_and_revocation_fail_closed_after_binding",
      "expected_case_count": 2,
      "verified_invariants": ["p4_credential_call_edge_only"],
      "success_criteria": "旧凭证引用在轮换或撤销提交后不能进入 Adapter 调用边缘，失败事实不包含明文凭证。"
    },
    {
      "scenario_id": "p412-approval-expiry-005",
      "title": "确认拒绝、撤回和审批过期均不能使步骤可执行",
      "capability": "approval_expiry",
      "sample_classes": ["failure", "denial"],
      "source_case_refs": ["p401-expired-confirmation-denied-011"],

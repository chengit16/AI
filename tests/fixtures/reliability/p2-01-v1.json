      "case_id": "p201-ingestion-duplicate-001",
      "category": "duplicate",
      "component": "ingestion_worker",
      "synthetic": true,
      "preconditions": [
        "同一合成文档已创建一条待处理入库任务。",
        "消费幂等存储和对象存储可用。"
      ],
      "fault_injection": {
        "injection_point": "ingestion.delivery.before_ack",
        "trigger": "在首次处理已提交但确认前重复投递相同任务信封。",
        "occurrences": 2
      },
      "steps": [
        "执行首次入库投递并在确认点制造断连。",
        "重复投递相同任务标识与 Trace。",
        "核对任务、产物、Chunk 和发布指针数量。"
      ],
      "expected": {
        "terminal_state": "recovered",
        "verified_invariants": [
          "duplicate_delivery_zero_side_effects",
          "immutable_attempt_history",
          "audit_outbox_atomicity"
        ],
        "error_code": null,
        "retryable": false,
        "maximum_recovery_seconds": 180,
        "duplicate_side_effects": 0,
        "cross_workspace_exposure": false,
        "authorization_behavior": "not_applicable",
        "evidence_sources": [
          "任务与 Attempt 事实",
          "消费幂等记录",
          "解析产物和 Chunk 摘要"
        ]
      },
      "cleanup": ["删除本场景创建的合成工作空间 Schema 和对象前缀。"]
    },

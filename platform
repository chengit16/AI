usage() {
  cat <<'EOF'
用法: ./platform <command>

命令:
  start    检查环境、构建镜像并启动全部服务
  stop     停止服务并保留本地数据
  restart  重启全部服务
  status   显示容器与健康状态
  logs     查看最近日志，可追加服务名
  admin    本地授予或撤销平台管理员: admin <grant|revoke> <login_name>
  backup   创建默认路径的加密恢复包，可追加输出路径
  restore  从恢复包替换本地数据: restore <bundle> --confirm-replace
  export   与 backup 使用同一版本化加密格式，必须指定输出路径
  import   与 restore 使用同一校验和恢复流程，必须显式确认替换
  rotate-master-key  备份后重包裹供应商凭据并轮换本地主密钥
  doctor   执行服务与基础设施诊断
  drill-stage-2  执行阶段 2 联合故障演练并生成本地 JSON 证据
EOF
}

command_name="${1:-}"
case "$command_name" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  logs) shift; logs "$@" ;;
  admin) shift; platform_admin "$@" ;;
  backup) shift; backup_local "$@" ;;
  restore) shift; restore_local "$@" ;;
  export) shift; [[ -n "${1:-}" ]] || fail "用法: ./platform export <output.aiprb>"; backup_local "$@" ;;
  import) shift; restore_local "$@" ;;
  rotate-master-key) shift; rotate_master_key "$@" ;;
  doctor) doctor ;;
  drill-stage-2) drill_stage_2 ;;
  *) usage; [[ -z "$command_name" ]] || exit 1 ;;
esac

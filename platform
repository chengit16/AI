#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="$PROJECT_DIR/infra/compose/compose.yaml"
ENV_FILE="$PROJECT_DIR/.env"
DEFAULT_ENV_FILE="$PROJECT_DIR/.env.example"
WORKER_SERVICES=(worker-control worker-parsing worker-ocr worker-embedding worker-indexing scheduler)
REQUIRED_RUNNING_SERVICES=(postgres valkey minio tika api web "${WORKER_SERVICES[@]}")

log() {
  printf '[AI Platform] %s\n' "$*"
}

fail() {
  printf '[AI Platform] 错误: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "缺少命令: $1"
}

compose() {
  docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

env_value() {
  local key="$1" fallback="${2:-}"
  local value
  value="$(awk -F= -v key="$key" '$1 == key {print substr($0, index($0, "=") + 1)}' "$ENV_FILE" | tail -n 1)"
  printf '%s' "${value:-$fallback}"
}

resolve_local_path() {
  local value="$1"
  if [[ "$value" == /* ]]; then
    printf '%s' "$value"
  else
    printf '%s' "$PROJECT_DIR/${value#./}"
  fi
}

run_python() {
  if [[ -x "$PROJECT_DIR/.venv/bin/python" ]]; then
    "$PROJECT_DIR/.venv/bin/python" "$@"
  else
    require_command uv
    uv run --locked python "$@"
  fi
}

canonicalize_local_path() {
  run_python -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve(strict=False))' "$1"
}

ensure_environment() {
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$DEFAULT_ENV_FILE" "$ENV_FILE"
    log "已根据 .env.example 创建本地 .env"
  fi

  # 本地数据与密钥目录由 .env 配置，主密钥生成在独立函数中完成。
  local root_path backup_root
  root_path="$(resolve_local_path "$(env_value AI_PLATFORM_ROOT ./.ai-platform)")"
  backup_root="$(resolve_local_path "$(env_value AI_PLATFORM_BACKUP_ROOT ./AIPlatformBackups)")"
  export AI_PLATFORM_ROOT="$root_path"
  export AI_PLATFORM_BACKUP_ROOT="$backup_root"
  mkdir -p \
    "$root_path/data/postgres" \
    "$root_path/data/valkey" \
    "$root_path/data/objects" \
    "$root_path/logs" \
    "$root_path/runtime" \
    "$root_path/runtime/prometheus" \
    "$root_path/secrets" \
    "$backup_root"
}

ensure_master_key() {
  local master_key="$AI_PLATFORM_ROOT/secrets/master.key"
  [[ ! -L "$master_key" ]] || fail "平台主密钥不能是符号链接"
  if [[ ! -f "$master_key" ]]; then
    umask 077
    openssl rand 32 >"$master_key"
    log "已生成本地平台主密钥"
  fi
  chmod 600 "$master_key"
  [[ "$(wc -c <"$master_key" | tr -d ' ')" == "32" ]] || fail "平台主密钥长度必须为 32 字节"
}

ensure_task_signing_key() {
  local signing_key="$AI_PLATFORM_ROOT/secrets/task-signing.key"
  [[ ! -L "$signing_key" ]] || fail "内部任务签名密钥不能是符号链接"
  if [[ ! -f "$signing_key" ]]; then
    umask 077
    openssl rand 32 >"$signing_key"
    log "已生成内部任务签名密钥"
  fi
  chmod 600 "$signing_key"
  [[ "$(wc -c <"$signing_key" | tr -d ' ')" == "32" ]] || fail "内部任务签名密钥长度必须为 32 字节"
}

ensure_backup_key() {
  local backup_key="$AI_PLATFORM_ROOT/secrets/backup-encryption.key"
  [[ ! -L "$backup_key" ]] || fail "恢复包加密密钥不能是符号链接"
  if [[ ! -f "$backup_key" ]]; then
    umask 077
    openssl rand 32 >"$backup_key"
    log "已生成独立恢复包加密密钥；机器外恢复前必须另行安全保管该文件"
  fi
  chmod 600 "$backup_key"
  [[ "$(wc -c <"$backup_key" | tr -d ' ')" == "32" ]] || fail "恢复包加密密钥长度必须为 32 字节"
}

export_local_service_settings() {
  local postgres_user postgres_password postgres_database postgres_port
  postgres_user="$(env_value POSTGRES_USER ai_platform)"
  postgres_password="$(env_value POSTGRES_PASSWORD local-development-only)"
  postgres_database="$(env_value POSTGRES_DB ai_platform)"
  postgres_port="$(env_value POSTGRES_PORT 5432)"
  export AI_PLATFORM_DATABASE_URL="postgresql+psycopg://${postgres_user}:${postgres_password}@127.0.0.1:${postgres_port}/${postgres_database}"
  export AI_PLATFORM_MINIO_ENDPOINT="http://127.0.0.1:$(env_value MINIO_API_PORT 9000)"
  export AI_PLATFORM_MINIO_ACCESS_KEY="$(env_value MINIO_ROOT_USER ai-platform-local)"
  export AI_PLATFORM_MINIO_SECRET_KEY="$(env_value MINIO_ROOT_PASSWORD local-development-only)"
  export AI_PLATFORM_MINIO_BUCKET="$(env_value MINIO_BUCKET ai-platform-documents)"
}

set_env_value() {
  local key="$1" value="$2" temporary
  temporary="$(mktemp "${TMPDIR:-/tmp}/ai-platform-env.XXXXXX")"
  awk -v key="$key" -v value="$value" '
    BEGIN { found = 0 }
    index($0, key "=") == 1 { print key "=" value; found = 1; next }
    { print }
    END { if (!found) print key "=" value }
  ' "$ENV_FILE" >"$temporary"
  mv "$temporary" "$ENV_FILE"
}

check_runtime() {
  require_command docker
  require_command curl
  docker info >/dev/null 2>&1 || fail "Docker Engine 未运行"
  docker compose version >/dev/null 2>&1 || fail "Docker Compose 不可用"
}

check_resources() {
  local cpu_count memory_bytes free_kb min_free_disk_gb
  if [[ "$(uname -s)" == "Darwin" ]]; then
    cpu_count="$(sysctl -n hw.logicalcpu)"
    memory_bytes="$(sysctl -n hw.memsize)"
  else
    cpu_count="$(getconf _NPROCESSORS_ONLN)"
    memory_bytes="$(awk '/MemTotal/ {print $2 * 1024}' /proc/meminfo)"
  fi
  free_kb="$(df -Pk "$PROJECT_DIR" | awk 'NR == 2 {print $4}')"
  min_free_disk_gb="${AI_PLATFORM_MIN_FREE_DISK_GB:-50}"
  [[ "$min_free_disk_gb" =~ ^[1-9][0-9]*$ ]] || fail "AI_PLATFORM_MIN_FREE_DISK_GB 必须是正整数"
  log "主机资源: ${cpu_count} 核 CPU，$((memory_bytes / 1024 / 1024 / 1024)) GB 内存，$((free_kb / 1024 / 1024)) GB 可用磁盘"
  (( cpu_count >= 8 )) || log "警告: CPU 少于建议的 8 核，功能可运行但处理速度可能较慢"
  (( memory_bytes >= 16 * 1024 * 1024 * 1024 )) || log "警告: 内存少于建议的 16 GB，请限制本地数据集规模"
  (( free_kb >= min_free_disk_gb * 1024 * 1024 )) || fail "可用磁盘少于 ${min_free_disk_gb} GB，不能安全启动本地数据服务"
}

check_port() {
  local port="$1"
  if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    if ! compose ps --format json 2>/dev/null | grep -q "127.0.0.1:$port"; then
      fail "端口 $port 已被其他进程占用"
    fi
  fi
}

wait_until_healthy() {
  local deadline=$((SECONDS + 300))
  while (( SECONDS < deadline )); do
    local unhealthy
    unhealthy="$(compose ps --format json | grep -cE '"Health":"(starting|unhealthy)"' || true)"
    local running
    running="$(compose ps --services --status running | wc -l | tr -d ' ')"
    # Migration 是一次性任务，不计入常驻服务；其余必需服务全部运行后才允许启动返回。
    if [[ "$unhealthy" == "0" && "$running" == "${#REQUIRED_RUNNING_SERVICES[@]}" ]]; then
      return 0
    fi
    sleep 3
  done
  compose ps
  fail "服务未在 300 秒内全部通过健康检查"
}

start() {
  check_runtime
  check_resources
  ensure_environment
  require_command openssl
  ensure_master_key
  ensure_task_signing_key
  for port in 3000 8000 5432 6379 9000 9001 9998; do
    check_port "$port"
  done
  compose config --quiet
  log "正在构建并启动本地服务"
  # 基础设施改名后清理旧 Compose 孤儿容器，绑定的数据目录仍保留在宿主机。
  compose up -d --build --remove-orphans
  wait_until_healthy
  log "平台已就绪: http://127.0.0.1:3000/status"
}

stop() {
  ensure_environment
  compose down
  log "平台服务已停止，本地数据目录已保留"
}

status() {
  ensure_environment
  compose ps
}

logs() {
  ensure_environment
  compose logs --tail=200 "${@:1}"
}

platform_admin() {
  ensure_environment
  local action="${1:-}" login_name="${2:-}"
  [[ "$action" == "grant" || "$action" == "revoke" ]] || fail "用法: ./platform admin <grant|revoke> <login_name>"
  [[ -n "$login_name" && "$login_name" != *$'\n'* ]] || fail "平台管理员登录名不能为空或包含换行"
  compose ps --services --status running | grep -qx postgres || fail "PostgreSQL 尚未运行"

  local sql
  if [[ "$action" == "grant" ]]; then
    # 本地运维命令是平台管理员唯一提权入口，Web/API 不能把空间所有者提升为平台管理员。
    sql="
      INSERT INTO public.platform_administrators (
        account_id, status, granted_by_account_id, granted_at, revoked_at
      )
      SELECT account_id, 'active', account_id, CURRENT_TIMESTAMP, NULL
        FROM public.accounts
       WHERE login_name = lower(btrim(:'login_name'))
      ON CONFLICT (account_id) DO UPDATE
        SET status = 'active', granted_by_account_id = EXCLUDED.granted_by_account_id,
            granted_at = EXCLUDED.granted_at, revoked_at = NULL;
    "
  else
    sql="
      UPDATE public.platform_administrators
         SET status = 'revoked', revoked_at = CURRENT_TIMESTAMP
       WHERE account_id = (
         SELECT account_id FROM public.accounts
          WHERE login_name = lower(btrim(:'login_name'))
       ) AND status = 'active';
    "
  fi
  compose exec -T postgres psql -v ON_ERROR_STOP=1 -v login_name="$login_name" \
    -U ai_platform -d ai_platform >/dev/null <<<"$sql"
  local status_value
  status_value="$(
    compose exec -T postgres psql -v ON_ERROR_STOP=1 -v login_name="$login_name" \
      -U ai_platform -d ai_platform -Atq <<<\
      "SELECT COALESCE((SELECT pa.status FROM public.platform_administrators pa JOIN public.accounts a USING (account_id) WHERE a.login_name = lower(btrim(:'login_name'))), 'not_found');"
  )"
  status_value="$(printf '%s' "$status_value" | tr -d '[:space:]')"
  [[ "$status_value" != "not_found" ]] || fail "未找到已注册账号: $login_name"
  log "平台管理员状态已更新: $login_name -> $status_value"
}

backup_local() {
  # 1. 固定本次备份的本地依赖、密钥和输出边界，禁止把恢复包写回事实数据目录。
  check_runtime
  ensure_environment
  require_command openssl
  ensure_master_key
  ensure_task_signing_key
  ensure_backup_key
  export_local_service_settings
  compose ps --services --status running | grep -qx postgres || fail "PostgreSQL 尚未运行"
  compose ps --services --status running | grep -qx minio || fail "MinIO 尚未运行"

  local requested_output="${1:-}" output_path timestamp revision local_data_root
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  if [[ -n "$requested_output" ]]; then
    output_path="$(resolve_local_path "$requested_output")"
  else
    output_path="$AI_PLATFORM_BACKUP_ROOT/ai-platform-$timestamp.aiprb"
  fi
  output_path="$(canonicalize_local_path "$output_path")"
  local_data_root="$(canonicalize_local_path "$AI_PLATFORM_ROOT")"
  [[ "$output_path" == *.aiprb ]] || fail "恢复包文件必须使用 .aiprb 后缀"
  [[ "$output_path" != "$local_data_root" && "$output_path" != "$local_data_root/"* ]] || \
    fail "恢复包输出路径不能位于本地事实数据目录内"
  [[ ! -e "$output_path" && ! -L "$output_path" ]] || fail "恢复包输出路径已经存在"
  mkdir -p "$(dirname "$output_path")"

  # 2. 停写前先关闭已知对象缺口；数据库与对象快照随后在同一停写窗口取得。
  run_python scripts/check_object_references.py || fail "对象引用不一致，拒绝创建恢复包"
  revision="$(compose exec -T postgres psql -U "$(env_value POSTGRES_USER ai_platform)" -d "$(env_value POSTGRES_DB ai_platform)" -Atqc 'SELECT version_num FROM public.alembic_version')"
  revision="$(printf '%s' "$revision" | tr -d '[:space:]')"
  [[ -n "$revision" ]] || fail "无法读取当前数据库 Revision"

  # 停止所有业务写入方和 MinIO 后再取得数据库逻辑快照与对象物理快照，保证两者同一停写窗口。
  (
    local staging stopped
    staging="$(mktemp -d "${TMPDIR:-/tmp}/ai-platform-backup.XXXXXX")"
    stopped=0
    cleanup_backup() {
      rm -rf -- "$staging"
      if (( stopped == 1 )); then
        compose up -d minio api "${WORKER_SERVICES[@]}" >/dev/null 2>&1 || true
      fi
    }
    trap cleanup_backup EXIT
    mkdir -p "$staging/secrets"
    stopped=1
    compose stop api "${WORKER_SERVICES[@]}" minio >/dev/null
    compose exec -T postgres pg_dump \
      --format=custom --no-owner --no-privileges \
      -U "$(env_value POSTGRES_USER ai_platform)" \
      -d "$(env_value POSTGRES_DB ai_platform)" >"$staging/database.dump"
    run_python scripts/local_recovery.py snapshot-objects \
      --source-root "$AI_PLATFORM_ROOT/data/objects" \
      --output "$staging/objects.tar"
    cp "$AI_PLATFORM_ROOT/secrets/master.key" "$staging/secrets/master.key"
    cp "$AI_PLATFORM_ROOT/secrets/task-signing.key" "$staging/secrets/task-signing.key"
    printf '%s\n' "$(env_value MASTER_KEY_VERSION 1)" >"$staging/secrets/master.key.version"
    chmod 600 "$staging/secrets/"*
    run_python scripts/local_recovery.py pack \
      --staging-root "$staging" \
      --output "$output_path" \
      --key-file "$AI_PLATFORM_ROOT/secrets/backup-encryption.key" \
      --schema-revision "$revision"
    compose up -d minio api "${WORKER_SERVICES[@]}" >/dev/null
    stopped=0
  )
  # 3. 业务容器全部恢复健康后才向调用方宣告备份成功。
  wait_until_healthy
  log "加密恢复包已创建: $output_path"
}

restore_local() {
  # 1. 先验证破坏性确认参数，再生成可独立回退的操作前恢复包。
  local requested_bundle="${1:-}" confirmation="${2:-}"
  [[ -n "$requested_bundle" && "$confirmation" == "--confirm-replace" ]] || \
    fail "用法: ./platform restore <bundle.aiprb> --confirm-replace"
  check_runtime
  ensure_environment
  ensure_backup_key
  export_local_service_settings

  local bundle_path timestamp pre_restore
  bundle_path="$(canonicalize_local_path "$(resolve_local_path "$requested_bundle")")"
  [[ -f "$bundle_path" && ! -L "$bundle_path" ]] || fail "恢复包不存在或不是普通文件"
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  pre_restore="$AI_PLATFORM_BACKUP_ROOT/pre-restore-$timestamp.aiprb"
  backup_local "$pre_restore"

  (
    local staging restored previous_objects restored_version
    staging="$(mktemp -d "${TMPDIR:-/tmp}/ai-platform-restore.XXXXXX")"
    restored="$staging/restored"
    previous_objects="$AI_PLATFORM_ROOT/runtime/objects-before-restore-$timestamp"
    # 子 Shell 无论正常结束还是因 set -e 中止，都会清理可能含明文密钥的解包目录。
    trap 'rm -rf -- "$staging"' EXIT

    # 2. 在停止服务前完成认证、路径和摘要验证，非法恢复包不得触碰现有事实。
    run_python scripts/local_recovery.py unpack \
      --bundle "$bundle_path" \
      --target-root "$restored" \
      --key-file "$AI_PLATFORM_ROOT/secrets/backup-encryption.key"

    # 3. 停止全部状态写入方后替换数据库、对象和文件密钥；失败时保持服务停止。
    compose stop api "${WORKER_SERVICES[@]}" minio valkey >/dev/null
    compose exec -T postgres pg_restore \
      --clean --if-exists --exit-on-error --no-owner --no-privileges \
      -U "$(env_value POSTGRES_USER ai_platform)" \
      -d "$(env_value POSTGRES_DB ai_platform)" <"$restored/database.dump"
    mv "$AI_PLATFORM_ROOT/data/objects" "$previous_objects"
    mkdir -p "$AI_PLATFORM_ROOT/data/objects"
    run_python scripts/local_recovery.py restore-objects \
      --snapshot "$restored/objects.tar" \
      --target-root "$AI_PLATFORM_ROOT/data/objects"
    install -m 600 "$restored/secrets/master.key" "$AI_PLATFORM_ROOT/secrets/master.key"
    install -m 600 "$restored/secrets/task-signing.key" "$AI_PLATFORM_ROOT/secrets/task-signing.key"
    restored_version="$(tr -d '[:space:]' <"$restored/secrets/master.key.version")"
    [[ "$restored_version" =~ ^[1-9][0-9]*$ ]] || fail "恢复包主密钥版本无效"
    set_env_value MASTER_KEY_VERSION "$restored_version"

    # 4. 清空可重建状态、迁移 Schema 并执行对象与八项诊断，全部通过后删除旧对象副本。
    compose start valkey >/dev/null
    compose exec -T valkey valkey-cli FLUSHALL >/dev/null
    compose exec -T valkey valkey-cli BGREWRITEAOF >/dev/null || true
    compose run --rm migrate >/dev/null
    compose up -d --remove-orphans >/dev/null
    wait_until_healthy
    export_local_service_settings
    run_python scripts/check_object_references.py || fail "恢复后对象引用不一致"
    doctor
    rm -rf -- "$previous_objects"
  )
  log "恢复完成；操作前快照保留在: $pre_restore"
}

rotate_master_key() {
  # 1. 主密钥跨介质更新无法形成单一事务，因此先创建最终回退点并准备下一版本密钥。
  [[ "${1:-}" == "--confirm" ]] || fail "用法: ./platform rotate-master-key --confirm"
  check_runtime
  ensure_environment
  require_command openssl
  ensure_backup_key
  export_local_service_settings

  local timestamp safety_backup old_version new_version current_key next_key previous_key
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  safety_backup="$AI_PLATFORM_BACKUP_ROOT/pre-key-rotation-$timestamp.aiprb"
  backup_local "$safety_backup"
  old_version="$(env_value MASTER_KEY_VERSION 1)"
  [[ "$old_version" =~ ^[1-9][0-9]*$ ]] || fail "当前主密钥版本无效"
  (( old_version < 2147483647 )) || fail "主密钥版本已经达到支持上限"
  new_version=$((old_version + 1))
  current_key="$AI_PLATFORM_ROOT/secrets/master.key"
  next_key="$AI_PLATFORM_ROOT/secrets/master.key.next"
  previous_key="$AI_PLATFORM_ROOT/secrets/master.key.previous"
  [[ ! -e "$next_key" && ! -e "$previous_key" ]] || fail "存在未清理的主密钥轮换文件"
  umask 077
  openssl rand 32 >"$next_key"
  chmod 600 "$next_key"

  # 2. API 停止期间以单一数据库事务重包裹全部数据密钥，失败则继续保留旧文件密钥。
  compose stop api >/dev/null
  if ! run_python scripts/rotate_master_key.py \
    --old-key-file "$current_key" --old-version "$old_version" \
    --new-key-file "$next_key" --new-version "$new_version"; then
    rm -f -- "$next_key"
    compose start api >/dev/null
    fail "凭据数据密钥重包裹失败，数据库已回滚"
  fi

  # 3. 数据库提交后再提升文件密钥和版本配置，健康诊断通过才删除旧密钥回退文件。
  mv "$current_key" "$previous_key"
  mv "$next_key" "$current_key"
  set_env_value MASTER_KEY_VERSION "$new_version"
  compose up -d --force-recreate api >/dev/null
  wait_until_healthy
  doctor
  rm -f -- "$previous_key"
  log "主密钥轮换完成: version=$new_version；轮换前恢复包: $safety_backup"
}

doctor() {
  check_runtime
  ensure_environment
  compose config --quiet

  local failed=0
  local checks=(
    "Web|http://127.0.0.1:3000/status"
    "API|http://127.0.0.1:8000/api/v1/health/ready"
    "MinIO|http://127.0.0.1:9000/minio/health/live"
    "Tika|http://127.0.0.1:9998/version"
  )
  local item name url
  for item in "${checks[@]}"; do
    name="${item%%|*}"
    url="${item#*|}"
    if curl --fail --silent --show-error --max-time 5 "$url" >/dev/null; then
      log "$name: 正常"
    else
      log "$name: 失败"
      failed=1
    fi
  done

  if compose exec -T postgres pg_isready -U ai_platform -d ai_platform >/dev/null; then
    log "PostgreSQL: 正常"
  else
    log "PostgreSQL: 失败"
    failed=1
  fi
  local database_revision
  database_revision="$(
    compose exec -T postgres \
      psql -U ai_platform -d ai_platform -Atqc \
      'SELECT version_num FROM public.alembic_version' 2>/dev/null || true
  )"
  database_revision="$(printf '%s' "$database_revision" | tr -d '[:space:]')"
  if [[ "$database_revision" == "20260816_0047" ]]; then
    log "数据库 Revision: 正常 ($database_revision)"
  else
    log "数据库 Revision: 失败 (期望 20260816_0047，实际 ${database_revision:-unknown})"
    failed=1
  fi
  if [[ "$(compose exec -T valkey valkey-cli ping)" == "PONG" ]]; then
    log "Valkey: 正常"
  else
    log "Valkey: 失败"
    failed=1
  fi
  local worker_service
  for worker_service in worker-control worker-parsing worker-ocr worker-embedding worker-indexing; do
    if compose ps --format json "$worker_service" | grep -q '"Health":"healthy"'; then
      log "Worker ${worker_service#worker-}: 正常"
    else
      log "Worker ${worker_service#worker-}: 失败"
      failed=1
    fi
  done
  if compose ps --format json scheduler | grep -q '"Health":"healthy"'; then
    log "Scheduler: 正常"
  else
    log "Scheduler: 失败"
    failed=1
  fi

  (( failed == 0 )) || fail "存在未通过的诊断项"
  log "全部诊断项通过"
}


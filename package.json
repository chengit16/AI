{
  "name": "ai-intelligent-platform",
  "version": "0.0.0",
  "private": true,
  "description": "支持个人空间与企业空间的 AI 智能平台",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "contracts:check": ".venv/bin/python scripts/generate_contract_types.py --check",
    "contracts:generate": ".venv/bin/python scripts/generate_contract_types.py",
    "dev": "pnpm -r --parallel --if-present dev",
    "format": "pnpm -r --if-present format",
    "lint": "pnpm -r --if-present lint",
    "lint:python": "uv run --locked ruff check .",
    "test": "pnpm -r --if-present test",
    "test:python": "uv run --locked pytest",
    "typecheck:python": "uv run --locked mypy .",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "./scripts/verify"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
